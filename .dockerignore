# Keep the build context small and the image clean. Without this, `COPY . .`
# would drag the local uv .venv, git history, and caches into the image.
.venv
venv
env
ENV

.git
.gitignore

__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
.coverage.*
*.egg-info

# Secrets / local-only
.env
.envrc

# Generated / local notes (also ignored by .gitignore)
.understand-anything
docs
img

# Docker's own files
Dockerfile
.dockerignore