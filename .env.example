# AI Order Desk — environment config. Copy to `.env` and fill in.
# Nothing here is needed for the deterministic core / `make test`; these are
# consumed by the agent runtime (LLM nodes, RAG, tracing) in later slices.

# --- Chat model (Gemini) -----------------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Client-side throttle (requests/min) to stay under the model's quota.
# 5 is safe for the free tier; raise it (e.g. 60) on a paid tier for a snappier UI.
GEMINI_RPM=5

# --- RAG embeddings (local, keyless) -----------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LangSmith tracing / evals -----------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-order-desk