# AI Order Desk — environment config. Copy to `.env` and fill in.
# Nothing here is needed for the deterministic core / `make test`; these are
# consumed by the agent runtime (LLM nodes, RAG, tracing) in later slices.

# --- Chat model (Gemini) -----------------------------------------------------
GOOGLE_API_KEY=
# NOTE: confirm the exact published model id. "gemini flash 3.5" is not a real
# id; default below is a current Gemini Flash. Override here as needed.
GEMINI_MODEL=gemini-2.5-flash

# --- RAG embeddings (local, keyless) -----------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LangSmith tracing / evals -----------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-order-desk